# ═══════════════════════════════════════
# Hariram Motors — Backend Environment
# ═══════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=your_mongodb_connection_string_here

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 Storage (Used for all vehicle photos & compressed inventory media)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=hariramcars-media
R2_PUBLIC_URL=https://pub-a9d1044a70e94eda8754293b52dfe920.r2.dev

# ImgBB API Key (Used for customer reviews & banners)
IMGBB_API_KEY=your_imgbb_api_key_here

# Admin Seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=securepassword123
