{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend/src/*"]
    },
    "jsx": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "include": [
    "frontend/src/**/*",
    "frontend/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend/node_modules",
    "backend/node_modules"
  ]
}
